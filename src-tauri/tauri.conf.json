{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "tauri-webgpu-mirc",
  "version": "0.0.0",
  "identifier": "com.tauri.webgpu.mirc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https:"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "WebGPU mIRC",
        "width": 1280,
        "height": 900
      }
    ]
  }
}